# Variables de entorno; el servidor no carga .env automáticamente.
USE_PREDICTIVE=False
SMARTFRUIT_REPORTS_DIR=reports
PORT=3000

# Vision local: proceso persistente separado, inferencia en CPU.
# Configurar antes de iniciar la app. El primer trabajo carga el modelo.
SMARTFRUIT_VISION_BATCH_SIZE=32
# Ejecutable que ya contiene PyTorch/torchvision/Pillow; opcional si se detecta.
# SMARTFRUIT_VISION_PYTHON=C:\Program Files\Python314\python.exe
# SMARTFRUIT_VISION_INPUT_DIR=data/local/vision_input
# SMARTFRUIT_VISION_OUTPUT_DIR=data/local/vision_output
